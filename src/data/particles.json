[
  { "id": "pt-001", "char": "は", "romaji": "wa", "function": "Penanda topik kalimat (dibaca 'wa' walau ditulis は)", "examples": [ { "jp": "わたしは がくせいです。", "reading": "watashi wa gakusei desu.", "id": "Saya adalah pelajar." } ] },
  { "id": "pt-002", "char": "が", "romaji": "ga", "function": "Penanda subjek; juga penekan topik (kalimat tanya dengan 何/誰)", "examples": [ { "jp": "だれが きましたか。", "reading": "dare ga kimashita ka.", "id": "Siapa yang datang?" } ] },
  { "id": "pt-003", "char": "を", "romaji": "wo", "function": "Penanda objek langsung (dibaca 'o')", "examples": [ { "jp": "パンを たべます。", "reading": "pan wo tabemasu.", "id": "Makan roti." } ] },
  { "id": "pt-004", "char": "に", "romaji": "ni", "function": "Penunjuk tujuan, waktu, tempat keberadaan, dan penerima", "examples": [ { "jp": "がっこうに いきます。", "reading": "gakkou ni ikimasu.", "id": "Pergi ke sekolah." }, { "jp": "さんじに おきます。", "reading": "sanji ni okimasu.", "id": "Bangun jam 3." } ] },
  { "id": "pt-005", "char": "へ", "romaji": "e", "function": "Penunjuk arah tujuan (dibaca 'e')", "examples": [ { "jp": "にほんへ いきます。", "reading": "nihon e ikimasu.", "id": "Pergi ke Jepang." } ] },
  { "id": "pt-006", "char": "で", "romaji": "de", "function": "Tempat terjadinya aksi, alat/cara, dan bahasa", "examples": [ { "jp": "がっこうで べんきょうします。", "reading": "gakkou de benkyou shimasu.", "id": "Belajar di sekolah." }, { "jp": "じてんしゃで きます。", "reading": "jitensha de kimasu.", "id": "Datang dengan sepeda." } ] },
  { "id": "pt-007", "char": "と", "romaji": "to", "function": "Bersama dengan; juga penghubung daftar lengkap", "examples": [ { "jp": "ともだちと あそびます。", "reading": "tomodachi to asobimasu.", "id": "Bermain dengan teman." } ] },
  { "id": "pt-008", "char": "も", "romaji": "mo", "function": "'Juga'; pengganti は/が dalam pernyataan serupa", "examples": [ { "jp": "わたしも にほんじんです。", "reading": "watashi mo nihonjin desu.", "id": "Saya juga orang Jepang." } ] },
  { "id": "pt-009", "char": "や", "romaji": "ya", "function": "Daftar sebagian (…dan sebagainya), biasanya dengan など", "examples": [ { "jp": "ほんや ざっしを よみます。", "reading": "hon ya zasshi wo yomimasu.", "id": "Membaca buku, majalah, dan sebagainya." } ] },
  { "id": "pt-010", "char": "の", "romaji": "no", "function": "Penanda kepemilikan/keterangan", "examples": [ { "jp": "にほんの くるま", "reading": "nihon no kuruma", "id": "mobil Jepang" } ] },
  { "id": "pt-011", "char": "か", "romaji": "ka", "function": "Partikel tanya di akhir kalimat", "examples": [ { "jp": "にほんごが わかりますか。", "reading": "nihongo ga wakarimasu ka.", "id": "Apakah kamu mengerti bahasa Jepang?" } ] },
  { "id": "pt-012", "char": "ね", "romaji": "ne", "function": "Mencari persetujuan / konfirmasi ('ya kan?')", "examples": [ { "jp": "きょうは あついですね。", "reading": "kyou wa atsui desu ne.", "id": "Hari ini panas ya." } ] },
  { "id": "pt-013", "char": "よ", "romaji": "yo", "function": "Memberi informasi baru / menekankan ('lho')", "examples": [ { "jp": "あしたは やすみですよ。", "reading": "ashita wa yasumi desu yo.", "id": "Besok libur lho." } ] },
  { "id": "pt-014", "char": "から", "romaji": "kara", "function": "Titik awal (dari); juga 'karena' di akhir klausa", "examples": [ { "jp": "くじから ごじまで はたらきます。", "reading": "kuji kara goji made hatarakimasu.", "id": "Bekerja dari jam 9 sampai jam 5." }, { "jp": "あめですから いきません。", "reading": "ame desu kara ikimasen.", "id": "Karena hujan, tidak pergi." } ] },
  { "id": "pt-015", "char": "まで", "romaji": "made", "function": "Batas akhir (sampai)", "examples": [ { "jp": "ごじまで まちます。", "reading": "goji made machimasu.", "id": "Menunggu sampai jam 5." } ] },
  { "id": "pt-016", "char": "だけ", "romaji": "dake", "function": "'Hanya' (positif)", "examples": [ { "jp": "こどもだけ はいります。", "reading": "kodomo dake hairimasu.", "id": "Hanya anak-anak yang masuk." } ] },
  { "id": "pt-017", "char": "しか", "romaji": "shika", "function": "'Hanya' dengan kalimat negatif (…しか〜ない)", "examples": [ { "jp": "いちまんえんしか ありません。", "reading": "ichiman'en shika arimasen.", "id": "Hanya ada 10.000 yen." } ] },
  { "id": "pt-018", "char": "より", "romaji": "yori", "function": "Perbandingan ('daripada')", "examples": [ { "jp": "かばんより はこのほうが かるいです。", "reading": "kaban yori hako no hou ga karui desu.", "id": "Kotak lebih ringan daripada tas." } ] },
  { "id": "pt-019", "char": "など", "romaji": "nado", "function": "'Dan sebagainya', melengkapi や", "examples": [ { "jp": "りんごや みかんなどを かいました。", "reading": "ringo ya mikan nado wo kaimashita.", "id": "Membeli apel, jeruk, dan sebagainya." } ] },
  { "id": "pt-020", "char": "でも", "romaji": "demo", "function": "'Tetapi' di awal kalimat; juga 'bahkan'", "examples": [ { "jp": "あめですが、でも いきます。", "reading": "ame desu ga, demo ikimasu.", "id": "Hujan, tetapi saya pergi." } ] },
  { "id": "pt-021", "char": "くらい/ぐらい", "romaji": "kurai/gurai", "function": "Perkiraan jumlah ('sekitar')", "examples": [ { "jp": "じゅっぷんぐらい かかります。", "reading": "juppun gurai kakarimasu.", "id": "Membutuhkan sekitar 10 menit." } ] },
  { "id": "pt-022", "char": "が", "romaji": "ga", "function": "Penghubung 'tetapi' di tengah kalimat", "examples": [ { "jp": "にほんごは むずかしいですが、たのしいです。", "reading": "nihongo wa muzukashii desu ga, tanoshii desu.", "id": "Bahasa Jepang sulit, tetapi menyenangkan." } ] }
]